---
import "../styles/global.css";
import "../styles/crt.css";
import "../styles/galaxy.css";
import StarField from "../components/StarField.astro";
import { getContent, type Lang } from "../lib/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getContent(lang);
const dir = lang === "ar" ? "rtl" : "ltr";
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="theme-color" content="#08080e" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Silkscreen:wght@400;700&family=VT323&family=IBM+Plex+Mono:wght@400;600;700&family=IBM+Plex+Sans+Arabic:wght@400;500;700&family=Lalezar&display=swap"
      rel="stylesheet"
    />
    <noscript>
      <style>
        .reveal { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>
  </head>
  <body>
    <StarField />
    <div class="static-overlay" id="static-overlay" aria-hidden="true"></div>
    <div class="osd-flash" id="osd-flash" data-prefix={t.tv.channel} aria-hidden="true"></div>
    <slot />
    <script is:inline>
      // Channel tuning: any [data-channel] element triggers a static burst,
      // flashes the target channel number, then scrolls to the section.
      (function () {
        const overlay = document.getElementById("static-overlay");
        const flash = document.getElementById("osd-flash");
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        function tune(id, ch) {
          const el = document.getElementById(id);
          if (!el) return;
          if (reduce) {
            el.scrollIntoView();
            return;
          }
          overlay.classList.remove("on");
          flash.classList.remove("on");
          void overlay.offsetWidth; /* restart the burst animations */
          if (ch) flash.textContent = (flash.dataset.prefix || "CH") + " " + ch;
          overlay.classList.add("on");
          if (ch) flash.classList.add("on");
          setTimeout(() => el.scrollIntoView({ behavior: "smooth" }), 150);
        }
        window.__tune = tune;

        document.addEventListener("click", (e) => {
          const trigger = e.target.closest("[data-channel]");
          if (!trigger) return;
          const id =
            trigger.getAttribute("data-target") ||
            (trigger.getAttribute("href") || "").replace("#", "");
          if (!id) return;
          e.preventDefault();
          tune(id, trigger.getAttribute("data-channel"));
        });
      })();
    </script>
    <script is:inline>
      // 3D tilt + moving glare on cards and the TV, and starfield parallax.
      // Fine pointers only; skipped entirely for reduced motion.
      (function () {
        const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!fine || reduce) return;

        const TILT = [
          [".tv-shell", 4],
          [".vhs-card", 3.5],
          [".disk-card", 8],
        ];

        TILT.forEach(([sel, max]) => {
          document.querySelectorAll(sel).forEach((el) => {
            el.classList.add("tilt");
            const glare = document.createElement("span");
            glare.className = "tilt-glare";
            glare.setAttribute("aria-hidden", "true");
            el.appendChild(glare);

            let raf = 0;
            let last = null;
            el.addEventListener("mousemove", (e) => {
              last = e;
              if (raf) return;
              raf = requestAnimationFrame(() => {
                raf = 0;
                const r = el.getBoundingClientRect();
                const px = (last.clientX - r.left) / r.width;
                const py = (last.clientY - r.top) / r.height;
                el.style.setProperty("--ry", ((px - 0.5) * 2 * max).toFixed(2) + "deg");
                el.style.setProperty("--rx", (-(py - 0.5) * 2 * max).toFixed(2) + "deg");
                el.style.setProperty("--gx", (px * 100).toFixed(1) + "%");
                el.style.setProperty("--gy", (py * 100).toFixed(1) + "%");
              });
            });
            el.addEventListener("mouseleave", () => {
              el.style.setProperty("--rx", "0deg");
              el.style.setProperty("--ry", "0deg");
            });
          });
        });

        const stars = document.getElementById("stars");
        if (stars) {
          let raf = 0;
          let last = null;
          window.addEventListener("mousemove", (e) => {
            last = e;
            if (raf) return;
            raf = requestAnimationFrame(() => {
              raf = 0;
              const dx = (last.clientX / window.innerWidth - 0.5) * -12;
              const dy = (last.clientY / window.innerHeight - 0.5) * -12;
              stars.style.transform = "translate(" + dx.toFixed(1) + "px," + dy.toFixed(1) + "px)";
            });
          });
        }
      })();
    </script>
    <script is:inline>
      (function () {
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const els = document.querySelectorAll(".reveal");
        if (reduce || !("IntersectionObserver" in window)) {
          els.forEach((el) => el.classList.add("is-visible"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
        );
        els.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
