---
import { channels, getContent, type Lang } from "../lib/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getContent(lang);
const ch = channels.find((c) => c.key === "about")!;
---

<section id={ch.id} class="channel reveal">
  <p class="osd-tag">{t.tv.channel} {ch.num} ▸ {t.about.title}</p>
  <div class="vhs-card" style={`--sticker:${ch.sticker}`}>
    <span class="eyebrow-sticker">{t.about.eyebrow}</span>
    <h2 class="card-title">{t.about.title}</h2>
    <p class="mb-5 leading-relaxed">{t.about.summary}</p>
    <p class="font-bold mb-3">{t.about.certifications}</p>
    <ul class="pixel-list mb-5">
      {t.about.certs.map((cert) => <li>{cert}</li>)}
    </ul>
    <p class="panel-muted text-sm">{t.about.consultation}</p>
  </div>
</section>
