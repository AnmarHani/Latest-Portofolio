---
import { getContent, site, type Lang } from "../lib/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getContent(lang);
const year = new Date().getFullYear();
---

<footer class="mt-16 mb-10">
  <div class="colorbars mb-4" aria-hidden="true"></div>
  <p class="osd-tag" style="margin-bottom: 0.25rem;">
    {t.tv.signoff} <span class="screen-cursor" aria-hidden="true"></span>
  </p>
  <p class="text-xs" style="color: rgba(235, 227, 208, 0.5);">
    © {year} {site.name}
  </p>
</footer>
