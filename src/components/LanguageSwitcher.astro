---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getContent, type Lang } from "../lib/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const other: Lang = lang === "en" ? "ar" : "en";
const switchUrl = getRelativeLocaleUrl(other);
const label = getContent(lang).langSwitcher[other];
---

<div class="fixed top-4 z-50" style="inset-inline-end: 1rem;">
  <a href={switchUrl} class="btn-8bit" style="padding: 0.55em 0.9em;" aria-label={`Switch language to ${label}`}>
    {label}
  </a>
</div>
