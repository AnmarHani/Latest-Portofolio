---
import { getContent, site, type Lang } from "../lib/content";
import CrtTv from "./CrtTv.astro";
import VhsShelf from "./VhsShelf.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getContent(lang);
---

<header id="ch-01" class="channel">
  <div class="tv-stage pt-4">
    <CrtTv lang={lang} />
    <VhsShelf lang={lang} />
  </div>

  <div class="ticker mt-10" role="marquee" aria-label={t.hero.brief}>
    <span class="ticker-badge"><span class="rec-dot">●</span> {t.tv.live}</span>
    <div class="ticker-viewport">
      <div class="ticker-track">
        <span>{t.hero.brief}</span>
        <span aria-hidden="true">{t.hero.brief}</span>
      </div>
    </div>
  </div>

  <div class="mt-7 text-center">
    <a href={site.links.linktree} target="_blank" rel="noopener" class="btn-8bit btn-8bit--red">
      ▶ {t.hero.cta}
    </a>
  </div>
</header>
