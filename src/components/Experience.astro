---
import { channels, getContent, type Lang } from "../lib/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getContent(lang);
const ch = channels.find((c) => c.key === "experience")!;
---

<section id={ch.id} class="channel reveal">
  <p class="osd-tag">{t.tv.channel} {ch.num} ▸ {t.experience.title}</p>
  <div class="vhs-card" style={`--sticker:${ch.sticker}`}>
    <span class="eyebrow-sticker">{t.experience.eyebrow}</span>
    <h2 class="card-title">{t.experience.title}</h2>
    <div class="flex flex-wrap items-center gap-2 mb-4">
      <span class="eyebrow-sticker" style="margin-bottom: 0;">{t.experience.company}</span>
      <span class="font-bold">{t.experience.role}</span>
      <span class="chip">{t.experience.period}</span>
    </div>
    <ul class="pixel-list">
      {t.experience.details.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>
