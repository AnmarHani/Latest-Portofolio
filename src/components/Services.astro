---
import { channels, getContent, site, type Lang } from "../lib/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getContent(lang);
const ch = channels.find((c) => c.key === "services")!;
---

<section id={ch.id} class="channel reveal">
  <p class="osd-tag">{t.tv.channel} {ch.num} ▸ {t.services.title}</p>
  <div class="vhs-card" style={`--sticker:${ch.sticker}`}>
    <span class="eyebrow-sticker" style="color: var(--color-ink); text-shadow: none;">
      {t.services.eyebrow}
    </span>
    <h2 class="card-title">{t.services.title}</h2>
    <p class="panel-muted mb-5">{t.services.intro}</p>
    <div class="grid gap-3 sm:grid-cols-2">
      {
        t.services.items.map((item) => (
          <a href={site.links.cal} target="_blank" rel="noopener" class="guide-row">
            <span>{item}</span>
            <span class="arrow" aria-hidden="true">▶</span>
          </a>
        ))
      }
    </div>
  </div>
</section>
